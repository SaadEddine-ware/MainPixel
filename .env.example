# ===========================================
# MainPixel — Environment Variables
# Copy this to .env and fill in production values
# ===========================================

# ── PostgreSQL ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mainpixel
POSTGRES_USER=mainpixel
POSTGRES_PASSWORD=change_me_in_production

# ── Redis ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=change_me_in_production

# ── Backend (FastAPI) ──────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
DATABASE_URL=postgresql+asyncpg://mainpixel:change_me_in_production@localhost:5432/mainpixel
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LOG_LEVEL=INFO

# ── Default Admin ──────────────────────────
DEFAULT_ADMIN_EMAIL=superadmin@mainpixel.ma
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# ── Email (SMTP) ──────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=changeme
SMTP_FROM_NAME=MainPixel

# ── Frontend ───────────────────────────────
VITE_API_URL=http://localhost:8000/api
